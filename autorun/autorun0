#!/bin/bash
# Quick setup (must exit fast)
# __ROOT_PASSWORD__ replaced by build.sh from .env
echo "root:__ROOT_PASSWORD__" | chpasswd
loadkeys de-latin1 2>/dev/null || true
ssh-keygen -A 2>/dev/null || true
systemctl start sshd

# Background setup
nohup bash /run/archiso/bootmnt/autorun/setup.sh &>/var/log/rescue-setup.log &
exit 0